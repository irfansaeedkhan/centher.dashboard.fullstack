NEXT_PUBLIC_NODE_API_HOST=localhost:5000
NEXT_PUBLIC_APP_ENV=development

# Cookies and Sessions
# Value of COOKIES_SECRET is taken from Node JS API backend, see .env file on Node JS API backend
COOKIES_SECRET=change_this_secret_in_production

# Accounts are only for development, not for production
NEXT_PUBLIC_ADMIN_ACCOUNT=0xA3433825cd187fe81deCfdc64efCEaeaeb2C256C

# Signup Registration Fee in BNB. Should match the value in Node JS API backend
NEXT_PUBLIC_SIGNUP_REGISTRATION_FEE_BNB_WITH_REFERRAL=0.025
NEXT_PUBLIC_SIGNUP_REGISTRATION_FEE_BNB_WITHOUT_REFERRAL=0.075