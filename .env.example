DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
BETTER_AUTH_SECRET=generate-a-32-byte-hex-secret
BETTER_AUTH_URL=http://localhost:3002
NEXT_PUBLIC_BRAND_NAME=Sociaket
NEXT_PUBLIC_BRAND_DOMAIN=sociaket.com
# Demo emails stay on centher.io until the Phase 3 demo-domain decision.
NEXT_PUBLIC_DEMO_EMAIL=demo@centher.io
NEXT_PUBLIC_DEMO_PASSWORD=Demo1234!
NEXT_PUBLIC_CAPI_HOST=http://localhost:3002
NEXT_PUBLIC_CIS_HOST=http://localhost:3002
NEXT_PUBLIC_CFS_HOST=http://localhost:3002
NEXT_PUBLIC_APP_ENV=development
# Optional: keyed Sepolia RPC (e.g. Chainstack) for non-production chain
# reads. Leave unset to use the keyless public fallback (rpc.sepolia.org).
NEXT_PUBLIC_CHAINSTACK_RPC_URL=
